{
  "expo": {
    "name": "KalkulaPH",
    "slug": "kalkulaph",
    "owner": "erwinvalles",
    "version": "3.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101B3F"
    },
    "android": {
      "package": "ph.kalkula.app",
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101B3F"
      },
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "ph.kalkula.app",
      "buildNumber": "12"
    },
    "extra": {
      "ratesUrl": "https://raw.githubusercontent.com/erwinmehehe/kalkulaph/main/src/data/rates-2026.json",
      "eas": {
        "projectId": "39e2945e-2011-443a-ac11-2342cf02fa12"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-font"
    ]
  }
}
